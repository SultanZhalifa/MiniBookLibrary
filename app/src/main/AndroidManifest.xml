<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ISBN auto-fill calls the Google Books JSON API over HTTPS. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Barcode scanner for ISBN lookup. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- No storage permissions: covers come from the Photo Picker and exports/restores go
         through the Storage Access Framework, both of which grant per-file access. -->

    <application
        android:name=".MiniBookLibraryApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MiniBookLibrary"
        tools:targetApi="36">

        <!-- Single launcher activity that decides where to route based on session state. -->
        <activity
            android:name=".ui.RouterActivity"
            android:exported="true"
            android:theme="@style/Theme.MiniBookLibrary.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.onboarding.OnboardingActivity"
            android:exported="false"
            android:theme="@style/Theme.MiniBookLibrary" />

        <activity
            android:name=".ui.auth.AuthActivity"
            android:exported="false"
            android:theme="@style/Theme.MiniBookLibrary" />

        <!-- Not exported: only reachable through RouterActivity, which checks the session. -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.MiniBookLibrary"
            android:windowSoftInputMode="adjustResize" />

        <receiver
            android:name=".ui.widget.CurrentlyReadingWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>
    </application>
</manifest>
