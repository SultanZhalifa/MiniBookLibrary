<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="4dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="#FFFFFF"
    android:foreground="?attr/selectableItemBackground">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- 📖 Modern Book Icon dengan Gradient Background -->
        <androidx.cardview.widget.CardView
            android:id="@+id/iconCard"
            android:layout_width="72dp"
            android:layout_height="72dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/book_icon_gradient"/>

            <ImageView
                android:id="@+id/ivBookIcon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_book"
                android:layout_gravity="center"
                app:tint="#FFFFFF"/>
        </androidx.cardview.widget.CardView>

        <!-- 📝 Book Title -->
        <TextView
            android:id="@+id/tvBookTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Book Title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1F2937"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintStart_toEndOf="@id/iconCard"
            app:layout_constraintEnd_toStartOf="@id/tvReadBadge"
            app:layout_constraintTop_toTopOf="@id/iconCard"/>

        <!-- ✍️ Author -->
        <TextView
            android:id="@+id/tvAuthor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="by Author Name"
            android:textSize="14sp"
            android:textColor="#6B7280"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginStart="18dp"
            android:layout_marginTop="6dp"
            app:layout_constraintStart_toEndOf="@id/iconCard"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvBookTitle"/>

        <!-- 🏷️ Category & Year Tags (Modern Pills) -->
        <LinearLayout
            android:id="@+id/layoutInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="18dp"
            android:layout_marginTop="12dp"
            app:layout_constraintStart_toEndOf="@id/iconCard"
            app:layout_constraintBottom_toBottomOf="@id/iconCard">

            <TextView
                android:id="@+id/tvCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fiction"
                android:textSize="11sp"
                android:textColor="#667EEA"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/tag_modern"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/tvYear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2024"
                android:textSize="11sp"
                android:textColor="#6B7280"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/tag_modern_secondary"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"/>
        </LinearLayout>

        <!-- ✅ Read Badge (Modern) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/tvReadBadge"
            android:layout_width="32dp"
            android:layout_height="32dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#10B981"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="✓"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:gravity="center"/>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
