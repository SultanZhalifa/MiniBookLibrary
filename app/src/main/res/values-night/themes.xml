<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.MiniBookLibrary" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#A5A8FF</item>
        <item name="colorOnPrimary">#1B1F66</item>
        <item name="colorPrimaryContainer">#3B3FA0</item>
        <item name="colorOnPrimaryContainer">#E5E6FE</item>

        <item name="colorSecondary">#D8B4FE</item>
        <item name="colorOnSecondary">#3B0F65</item>
        <item name="colorSecondaryContainer">#5C2D8E</item>
        <item name="colorOnSecondaryContainer">#F2DCFB</item>

        <item name="colorTertiary">#F19CC2</item>
        <item name="colorOnTertiary">#5A1A3D</item>

        <item name="colorError">#FCA5A5</item>
        <item name="colorOnError">#5A1010</item>

        <item name="android:colorBackground">@color/surface_dark</item>
        <item name="colorSurface">@color/surface_dark_elevated</item>
        <item name="colorOnSurface">@color/text_primary_dark</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary_dark</item>
        <item name="colorSurfaceVariant">@color/surface_dark_subtle</item>
        <item name="colorOutline">@color/divider_dark</item>

        <item name="android:statusBarColor" tools:targetApi="lollipop">@android:color/transparent</item>
        <item name="android:navigationBarColor" tools:targetApi="lollipop">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>

        <item name="android:textColorPrimary">@color/text_primary_dark</item>
        <item name="android:textColorSecondary">@color/text_secondary_dark</item>

        <item name="materialAlertDialogTheme">@style/AlertDialog.MiniBookLibrary</item>
    </style>
</resources>
